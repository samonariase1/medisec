# -----------------------------------------------------------------------------
# MediSec local development configuration
# -----------------------------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=false

# Generate a real value before using the application.
# Do not commit a real production secret.
SECRET_KEY=replace-this-with-a-long-random-secret

# Local SQLite database.
# Render will override this with DATABASE_URL for PostgreSQL.
DATABASE_URL=sqlite:///instance/medisec.db

# Comma-separated list of allowed browser/frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# Set to true only when running behind HTTPS.
SESSION_COOKIE_SECURE=false

# Session lifetime in seconds.
PERMANENT_SESSION_LIFETIME=1800
